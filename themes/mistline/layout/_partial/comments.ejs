<% if (config.gitalk && config.gitalk.enable && is_post()) { %>
<% var gtId = legacy_gitalk_id(page); %>
<% if (gtId) { %>
<section class="comments" id="comments">
  <p class="comments-head">留言 / COMMENTS</p>
  <div id="gitalk-container" data-id="<%= gtId %>"></div>
</section>
<script id="gitalk-config" type="application/json"><%- JSON.stringify({ clientID: config.gitalk.clientID, clientSecret: config.gitalk.clientSecret, repo: config.gitalk.repo, owner: config.gitalk.owner, admin: [config.gitalk.admin], proxy: config.gitalk.proxy, id: gtId }) %></script>
<link rel="stylesheet" href="<%- url_for('plugins/gitalk.min.css') %>">
<script src="<%- url_for('plugins/gitalk.min.js') %>" defer></script>
<% } %>
<% } %>
